{
  "name": "finance-tracker-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute finance_tracker_db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute finance_tracker_db --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute finance_tracker_db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute finance_tracker_db --remote --file=./seed.sql",
    "db:drop:remote": "wrangler d1 execute finance_tracker_db --remote --command \"DROP TABLE IF EXISTS transactions; DROP TABLE IF EXISTS accounts; DROP TABLE IF EXISTS banks; DROP TABLE IF EXISTS categories; DROP TABLE IF EXISTS goals;\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.52.0",
    "wrangler": "^4.54.0"
  },
  "dependencies": {
    "zod": "^4.3.5"
  }
}